# Copy to .env (never commit .env)
LLM_PROVIDER=ollama          # ollama | anthropic | openai
LLM_MODEL=qwen2.5:7b         # needs a tool-calling model; e.g. qwen2.5:7b, llama3.1:8b, claude-sonnet-4-5, gpt-4o-mini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# MAX_TOOL_CALLS=12
